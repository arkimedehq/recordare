{
  "name": "@arkimedehq/recordare-service",
  "version": "0.1.0",
  "description": "Recordare \u2014 memory and digital-twin service (REST ingest + MCP)",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch --enable-source-maps -r @swc-node/register src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migration:run": "typeorm migration:run -d dist/db/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/db/data-source.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "openai": "^6.49.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.1.2",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "typescript": "6.0",
    "typescript-eslint": "^8.71.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
