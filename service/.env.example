# Copy to .env (gitignored). v1 home / research profile (D33).
DATABASE_URL=postgres://recordare:recordare@localhost:5433/recordare
REDIS_URL=redis://localhost:6380
# Bootstrap admin key (>= 32 chars). Generate: openssl rand -hex 32
ADMIN_API_KEY=change-me-change-me-change-me-change-me
IDLE_DELAY_SECONDS=900
# Nightly consolidation (M5): local hour after which each owner's day / month digests are written
CONSOLIDATION_HOUR=3
# Quality profile (D35): economy | balanced | full; owners may override it
QUALITY_PROFILE=balanced
# Optional: facts and notes in their own call on the FACTS task model (measured: no gain; off by default)
# FACTS_PASS=separate
# Optional: max characters per extraction call (overrides the profile, e.g. for small local models)
# EXTRACTION_WINDOW_CHARS=12000

# Any LLM provider (D27). Examples: DeepSeek, OpenAI, Ollama (http://localhost:11434/v1), vLLM…
LLM_PROVIDER=openai-compatible
LLM_PROFILE=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# One model (and optionally provider) per task — unset = the LLM_* defaults above. Tasks: EXTRACT, EXTRACT_ECONOMY, RESOLVE, FACTS, DIGEST.
# Recommended defaults (measured): all three on deepseek-flash. Example of a per-task override:
# LLM_RESOLVE_MODEL=deepseek-flash
# LLM_EXTRACT_ECONOMY_PROVIDER=openai-compatible
# LLM_EXTRACT_ECONOMY_PROFILE=openrouter
# LLM_EXTRACT_ECONOMY_BASE_URL=https://openrouter.ai/api/v1
# LLM_EXTRACT_ECONOMY_API_KEY=
# LLM_EXTRACT_ECONOMY_MODEL=google/gemini-3.1-flash-lite

# Any OpenAI-compatible embedding server (e.g. Arkimede's embedding-service, Ollama, the spike gateway)
EMBEDDING_BASE_URL=http://localhost:8790/v1
EMBEDDING_MODEL=st:BAAI/bge-m3
EMBEDDING_DIM=1024
