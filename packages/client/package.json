{
  "name": "@arkimedehq/recordare-client",
  "version": "0.1.0",
  "description": "Client library for Recordare, the memory service for agent platforms: identity, consent, ingest, deletions, MCP recall.",
  "license": "AGPL-3.0-or-later",
  "author": "Andrea Genovese",
  "homepage": "https://github.com/arkimedehq/recordare/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkimedehq/recordare.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/arkimedehq/recordare/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README_it.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "6.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
