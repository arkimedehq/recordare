  "description": "Client library for Recordare, the memory service for agent platforms: identity, consent, ingest, deletions, MCP recall.",
  "license": "AGPL-3.0-or-later",
  "author": "Andrea Genovese",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
